{%- liquid
  assign source_collection = blank
  for product_collection in product.collections
    if product_collection.handle == 'mombatti'
      assign source_collection = collections['mombatti'] | default: product_collection
      break
    elsif source_collection == blank
      assign source_collection = product_collection
    endif
  endfor
-%}

{%- if source_collection != blank and source_collection.products_count > 1 -%}
  <section class="mombatti-pdp__more">
    <div class="mayaloka-sec-head">
      <span class="mayaloka-label">{{ source_collection.title | escape }}</span>
      {%- if source_collection.handle == 'mombatti' -%}
        <h2>{{ section.settings.heading | escape }}</h2>
      {%- else -%}
        <h2>More from {{ source_collection.title | escape }}</h2>
      {%- endif -%}
    </div>
    <div class="mombatti-pdp__more-grid">
      {%- assign shown_count = 0 -%}
      {%- for related_product in source_collection.products -%}
        {%- if related_product.id != product.id and shown_count < section.settings.products_to_show -%}
          {%- assign shown_count = shown_count | plus: 1 -%}
          <a href="{{ related_product.url }}" class="mayaloka-mombatti__card">
            <div class="mayaloka-mombatti__img">
              {%- if related_product.featured_image -%}
                {{ related_product.featured_image | image_url: width: 700 | image_tag: loading: 'lazy', class: 'mayaloka-mombatti__photo', alt: related_product.featured_image.alt | default: related_product.title | escape }}
              {%- endif -%}
            </div>
            <div class="mayaloka-mombatti__info">
              <span class="mayaloka-mombatti__brand">{{ source_collection.title | escape }}</span>
              <h3>{{ related_product.title | escape }}</h3>
              <div class="mayaloka-mombatti__price">
                {%- if related_product.compare_at_price > related_product.price -%}
                  <s>{{ related_product.compare_at_price | money }}</s>{{ related_product.price | money }}
                {%- else -%}
                  {{ related_product.price | money }}
                {%- endif -%}
              </div>
            </div>
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </section>
{%- endif -%}

{% stylesheet %}
  .mombatti-pdp__more { max-width: 1240px; margin: 90px auto 0; padding: 48px 32px 80px; border-block: 1px solid rgba(146, 32, 33, .22); }
  .mombatti-pdp__more-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 22px; }
  .mombatti-pdp__more-grid .mayaloka-mombatti__card { display: block; width: auto; min-width: 0; color: inherit; text-decoration: none; }
  .mombatti-pdp__more-grid .mayaloka-mombatti__img { aspect-ratio: 4 / 5; position: relative; overflow: hidden; margin-bottom: 14px; background: var(--mayaloka-paper); }
  .mombatti-pdp__more-grid .mayaloka-mombatti__photo { display: block; width: 100%; height: 100%; object-fit: cover; transition: transform .5s ease; }
  .mombatti-pdp__more-grid .mayaloka-mombatti__card:hover .mayaloka-mombatti__photo { transform: scale(1.06); }
  .mombatti-pdp__more-grid .mayaloka-mombatti__brand { display: block; margin-bottom: 6px; color: var(--mayaloka-maroon); font-family: var(--mayaloka-font-label); font-size: 11px; letter-spacing: .1em; text-transform: uppercase; }
  .mombatti-pdp__more-grid .mayaloka-mombatti__info h3 { margin: 0 0 6px; color: var(--mayaloka-ink); font-family: var(--mayaloka-font-body); font-size: 15px; font-weight: 600; }
  .mombatti-pdp__more-grid .mayaloka-mombatti__price { color: var(--mayaloka-maroon); font-family: var(--mayaloka-font-body); font-size: 14px; font-weight: 600; }
  .mombatti-pdp__more-grid .mayaloka-mombatti__price s { margin-right: 6px; color: var(--mayaloka-ink-soft); font-weight: 400; }
  @media screen and (max-width: 900px) { .mombatti-pdp__more-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; } }
{% endstylesheet %}

{% schema %}
{
  "name": "Same collection products",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "More candles" },
    { "type": "range", "id": "products_to_show", "label": "Products to show", "min": 2, "max": 8, "step": 1, "default": 4 }
  ],
  "presets": [{ "name": "Same collection products" }]
}
{% endschema %}
