{% liquid
  assign kicker = section.settings.kicker
  assign heading = section.settings.heading
  assign heading_emphasis = section.settings.heading_emphasis
  assign subtext = section.settings.subtext
  assign primary_label = section.settings.primary_button_label
  assign primary_url = section.settings.primary_button_url
  assign secondary_label = section.settings.secondary_button_label
  assign secondary_url = section.settings.secondary_button_url
  assign badge_text = section.settings.badge_text
  assign hero_image = section.settings.hero_image
  assign hero_image_mobile = section.settings.hero_image_mobile
%}

<section class="mayaloka-hero mayaloka-hero--split{% if hero_image != blank %} mayaloka-hero--image{% endif %}{% if section.settings.size == 'compact' %} mayaloka-hero--compact{% endif %}">
  <div class="mayaloka-hero__story">
  {% if hero_image != blank %}
    {{ hero_image | image_url: width: 2400 | image_tag: loading: 'eager', fetchpriority: 'high', class: 'mayaloka-hero__image mayaloka-hero__image--desktop' }}
    {% if hero_image_mobile != blank %}
      {{ hero_image_mobile | image_url: width: 1600 | image_tag: loading: 'eager', fetchpriority: 'high', class: 'mayaloka-hero__image mayaloka-hero__image--mobile' }}
    {% endif %}
    <div class="mayaloka-hero__overlay"></div>
  {% endif %}
  <div class="mayaloka-hero__wrap">
    <div class="mayaloka-hero__frame">
      {% if kicker != blank %}
        <div class="mayaloka-hero__kicker">{{ kicker }}</div>
      {% endif %}
      {% if heading != blank or heading_emphasis != blank %}
        <h1 class="mayaloka-hero__heading">
          {{ heading }}{% if heading != blank and heading_emphasis != blank %}<br>{% endif %}<em>{{ heading_emphasis }}</em>
        </h1>
      {% endif %}
      {% if subtext != blank %}
        <p class="mayaloka-hero__subtext">{{ subtext }}</p>
      {% endif %}
      <div class="mayaloka-hero__ctas">
        {% if primary_label != blank %}
          <a href="{{ primary_url | default: routes.all_products_collection_url }}" class="mayaloka-btn mayaloka-btn--primary">{{ primary_label }}</a>
        {% endif %}
        {% if secondary_label != blank %}
          <a href="{{ secondary_url | default: '#mayaloka-story' }}" class="mayaloka-btn mayaloka-btn--outline">{{ secondary_label }}</a>
        {% endif %}
      </div>
      <div class="mayaloka-flourish">
        <span class="mayaloka-flourish__dash"></span>
        <span class="mayaloka-flourish__dot"></span>
        <span class="mayaloka-flourish__dash"></span>
      </div>
      {% if badge_text != blank %}
        <div class="mayaloka-hero__badge">{{ badge_text }}</div>
      {% endif %}
    </div>
  </div>
  </div>
  <div class="mayaloka-hero__mobile-ticker" aria-label="Mayaloka promises">
    <div class="mayaloka-hero__mobile-ticker-track">
      <span>Anti-tarnish, always</span><span>✦</span><span>Every piece feels discovered</span><span>✦</span><span>Modern meets nostalgia</span><span>✦</span><span>Handcrafted with trust</span><span>✦</span>
      <span aria-hidden="true">Anti-tarnish, always</span><span aria-hidden="true">✦</span><span aria-hidden="true">Every piece feels discovered</span><span aria-hidden="true">✦</span><span aria-hidden="true">Modern meets nostalgia</span><span aria-hidden="true">✦</span><span aria-hidden="true">Handcrafted with trust</span><span aria-hidden="true">✦</span>
    </div>
  </div>
  <div class="mayaloka-hero__collections" aria-label="Shop collections">
    <div class="mayaloka-hero__collection-grid">
      {% for block in section.blocks %}
        {% assign collection = block.settings.collection %}
        {% if collection != blank %}
          <a class="mayaloka-hero__collection" href="{{ collection.url }}" {{ block.shopify_attributes }}>
            {% assign gallery_image_count = 0 %}
            <span class="mayaloka-hero__collection-gallery" data-hero-product-gallery aria-label="{{ collection.title | escape }} collection images">
              {% if collection.featured_image != blank %}
                {{ collection.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', class: 'mayaloka-hero__collection-image is-active', alt: collection.title }}
                {% assign gallery_image_count = gallery_image_count | plus: 1 %}
              {% endif %}
              {% for product in collection.products limit: 8 %}
                {% if product.featured_image != blank %}
                  {% assign slide_class = 'mayaloka-hero__collection-image' %}
                  {% if gallery_image_count == 0 %}{% assign slide_class = slide_class | append: ' is-active' %}{% endif %}
                  {{ product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', class: slide_class, alt: product.title }}
                  {% assign gallery_image_count = gallery_image_count | plus: 1 %}
                {% endif %}
              {% endfor %}
              {% if gallery_image_count == 0 %}<span class="mayaloka-hero__collection-empty">{{ collection.title | escape }}</span>{% endif %}
            </span>
            <span class="mayaloka-hero__collection-title">{{ collection.title }}</span>
          </a>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

<script>
  (() => {
    const section = document.currentScript.previousElementSibling;
    const galleries = section?.querySelectorAll('[data-hero-product-gallery]');
    if (!galleries?.length) return;
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    galleries.forEach((gallery) => {
      const slides = [...gallery.querySelectorAll('.mayaloka-hero__collection-image')];
      if (slides.length < 2) return;
      let current = 0;
      let timer;
      let paused = false;
      const stop = () => window.clearInterval(timer);
      const start = () => {
        stop();
        if (paused || reducedMotion.matches) return;
        timer = window.setInterval(() => {
          slides[current].classList.remove('is-active');
          current = (current + 1) % slides.length;
          slides[current].classList.add('is-active');
        }, 3200);
      };
      gallery.addEventListener('mouseenter', () => { paused = true; stop(); });
      gallery.addEventListener('mouseleave', () => { paused = false; start(); });
      gallery.addEventListener('focusin', () => { paused = true; stop(); });
      gallery.addEventListener('focusout', () => { paused = false; start(); });
      if ('IntersectionObserver' in window) {
        new IntersectionObserver(([entry]) => { paused = !entry.isIntersecting; start(); }).observe(gallery);
      } else start();
    });
  })();
</script>

{% stylesheet %}
  .mayaloka-hero {
    position: relative;
    background:
      radial-gradient(circle at 50% 0%, rgba(166, 57, 44, .05), transparent 60%),
      var(--mayaloka-cream);
    padding: 86px 0 70px;
    text-align: center;
    overflow: hidden;
  }

  .mayaloka-hero--split {
    display: grid;
    grid-template-columns: minmax(0, 0.88fr) minmax(0, 1.12fr);
    align-items: stretch;
    min-height: min(590px, calc(100svh - 172px));
    padding: 0;
    text-align: center;
    background: var(--mayaloka-cream-light);
  }

  .mayaloka-hero__story {
    position: relative;
    min-height: min(590px, calc(100svh - 172px));
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background: var(--mayaloka-ink);
  }

  .mayaloka-hero__story > .mayaloka-hero__image,
  .mayaloka-hero__story > .mayaloka-hero__overlay { position: absolute; }

  .mayaloka-hero__story .mayaloka-hero__wrap { width: 100%; }

  .mayaloka-hero__story .mayaloka-hero__frame {
    max-width: 620px;
    padding: 84px 38px 30px;
  }

  .mayaloka-hero__story .mayaloka-hero__heading { font-size: clamp(34px, 3.8vw, 56px); }
  .mayaloka-hero__story .mayaloka-hero__subtext { max-width: 430px; }

  .mayaloka-hero__collections {
    display: flex;
    align-items: center;
    padding: 32px clamp(20px, 3vw, 52px);
    background: var(--mayaloka-cream-light);
    border-left: 5px solid var(--mayaloka-maroon);
  }

  .mayaloka-hero__collection-grid {
    width: 100%;
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 22px 16px;
    align-items: start;
  }

  .mayaloka-hero__collection {
    grid-column: span 3;
    min-width: 0;
    color: var(--mayaloka-ink);
    text-decoration: none;
    text-align: center;
  }

  .mayaloka-hero__collection:nth-child(n + 3) { grid-column: span 2; }

  .mayaloka-hero__collection-gallery,
  .mayaloka-hero__collection-empty {
    position: relative;
    display: block;
    width: 100%;
    height: clamp(145px, 16vw, 205px);
    overflow: hidden;
    border: 0;
    border-radius: 12px;
    box-shadow: 0 2px 10px rgba(36, 30, 25, .08);
  }

  .mayaloka-hero__collection-image { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; transition: opacity .65s ease; }
  .mayaloka-hero__collection-image.is-active { opacity: 1; }

  .mayaloka-hero__collection-empty { background: #e8dfce; padding: 70px 12px; }
  @media (prefers-reduced-motion: reduce) { .mayaloka-hero__collection-image { transition: none; } }
  .mayaloka-hero__mobile-ticker { display: none; }

  .mayaloka-hero__collection-title {
    display: block;
    margin-top: 10px;
    font-family: var(--mayaloka-font-display);
    font-size: clamp(15px, 1.35vw, 21px);
    letter-spacing: .03em;
    text-transform: uppercase;
  }

  .mayaloka-hero--image {
    min-height: min(590px, calc(100svh - 172px));
    display: flex;
    align-items: center;
    background: var(--mayaloka-ink);
  }

  .mayaloka-hero--split.mayaloka-hero--image {
    display: grid;
    grid-template-columns: minmax(0, .88fr) minmax(0, 1.12fr);
    align-items: stretch;
    min-height: min(590px, calc(100svh - 172px));
    padding: 0;
    background: var(--mayaloka-cream-light);
  }

  .mayaloka-hero__image,
  .mayaloka-hero__overlay {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .mayaloka-hero__image {
    object-fit: cover;
  }

  .mayaloka-hero__image--mobile {
    display: none;
  }

  .mayaloka-hero__overlay {
    background: linear-gradient(90deg, rgba(20, 16, 13, .72), rgba(20, 16, 13, .25) 68%, rgba(20, 16, 13, .12));
  }

  .mayaloka-hero__wrap {
    position: relative;
    z-index: 1;
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 32px;
  }

  .mayaloka-hero__frame {
    max-width: 920px;
    margin: 0 auto;
    padding: 104px 40px 34px;
    position: relative;
  }

  .mayaloka-hero--image .mayaloka-hero__kicker,
  .mayaloka-hero--image .mayaloka-hero__heading,
  .mayaloka-hero--image .mayaloka-hero__heading em,
  .mayaloka-hero--image .mayaloka-hero__subtext,
  .mayaloka-hero--image .mayaloka-hero__badge {
    color: var(--mayaloka-cream-light);
  }

  .mayaloka-hero--image .mayaloka-flourish__dash,
  .mayaloka-hero--image .mayaloka-flourish__dot {
    background: var(--mayaloka-cream-light);
  }

  .mayaloka-hero--image .mayaloka-btn--outline {
    border-color: var(--mayaloka-cream-light);
    color: var(--mayaloka-cream-light);
  }

  .mayaloka-hero__kicker {
    font-family: var(--mayaloka-font-label);
    font-size: 12px;
    letter-spacing: .22em;
    color: var(--mayaloka-maroon);
    text-transform: uppercase;
    margin-bottom: 18px;
  }

  .mayaloka-hero__heading {
    font-family: var(--mayaloka-font-display);
    font-weight: 600;
    font-size: clamp(40px, 6vw, 74px);
    line-height: 1.05;
    color: var(--mayaloka-maroon);
    margin: 0 0 20px;
  }

  .mayaloka-hero__heading em {
    font-style: italic;
    font-weight: 500;
    color: var(--mayaloka-gold);
  }

  .mayaloka-hero__subtext {
    max-width: 480px;
    margin: 0 auto 30px;
    color: var(--mayaloka-ink-soft);
    font-size: 16.5px;
  }

  .mayaloka-hero__ctas {
    display: flex;
    gap: 16px;
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: 30px;
  }

  .mayaloka-hero .mayaloka-flourish {
    margin: 0 auto 14px;
  }

  .mayaloka-hero__badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--mayaloka-font-label);
    font-size: 11px;
    letter-spacing: .14em;
    color: var(--mayaloka-gold);
    text-transform: uppercase;
  }

  @media (max-width: 989px) {
    .mayaloka-hero__frame {
      padding: 132px 32px 62px;
    }

  }

  @media (max-width: 749px) {
    .mayaloka-hero__story { min-height: 420px; }
    .mayaloka-hero__story .mayaloka-hero__frame { padding: 34px 18px 22px; }
    .mayaloka-hero__story .mayaloka-hero__kicker { font-size: 9px; letter-spacing: .12em; margin-bottom: 10px; }
    .mayaloka-hero__story .mayaloka-hero__heading { font-size: clamp(28px, 8vw, 34px); line-height: 1.08; margin-bottom: 12px; }
    .mayaloka-hero__story .mayaloka-hero__subtext { font-size: 13px; line-height: 1.45; margin-bottom: 14px; }
    .mayaloka-hero__collections { padding: 18px 16px 26px; }
    .mayaloka-hero__collection-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px 10px; }
    .mayaloka-hero__collection,
    .mayaloka-hero__collection:nth-child(n + 3) { grid-column: span 1; }
    .mayaloka-hero__collection:last-child:nth-child(odd) { grid-column: 1 / -1; width: calc((100% - 10px) / 2); justify-self: center; }
    .mayaloka-hero__collection-gallery,
    .mayaloka-hero__collection-empty { height: auto; aspect-ratio: 4 / 3; border-radius: 10px; }
    .mayaloka-hero__collection-title { font-size: 13px; margin-top: 8px; }
    .mayaloka-hero--image {
      min-height: 640px;
    }
    .mayaloka-hero--split.mayaloka-hero--image { min-height: 0; }

    .mayaloka-hero--image .mayaloka-hero__frame {
      text-align: center;
    }

    .mayaloka-hero--image .mayaloka-flourish {
      justify-content: center;
    }

    .mayaloka-hero__image--desktop:has(~ .mayaloka-hero__image--mobile) {
      display: none;
    }

    .mayaloka-hero__image--mobile {
      display: block;
    }

    .mayaloka-hero__overlay {
      background: rgba(20, 16, 13, .55);
    }

    .mayaloka-hero__frame {
      padding: 140px 22px 78px;
    }

  }

  /* Compact size: shorter hero so the collections show above the fold. */
  .mayaloka-hero--compact {
    padding: 56px 0 44px;
  }

  .mayaloka-hero--compact.mayaloka-hero--image {
    min-height: clamp(440px, 62vh, 560px);
  }

  .mayaloka-hero--compact.mayaloka-hero--split.mayaloka-hero--image { min-height: 0; }

  .mayaloka-hero--compact .mayaloka-hero__frame {
    max-width: 820px;
    padding: 80px 36px 24px;
  }

  .mayaloka-hero--compact .mayaloka-hero__kicker {
    margin-bottom: 12px;
  }

  .mayaloka-hero--compact .mayaloka-hero__heading {
    font-size: clamp(34px, 4.6vw, 58px);
    margin-bottom: 14px;
  }

  .mayaloka-hero--compact .mayaloka-hero__subtext {
    font-size: 15.5px;
    margin-bottom: 22px;
  }

  .mayaloka-hero--compact .mayaloka-hero__ctas {
    margin-bottom: 20px;
  }

  @media (max-width: 1190px) {
    .mayaloka-hero--split,
    .mayaloka-hero--split.mayaloka-hero--image { display: block; min-height: 0; }
    .mayaloka-hero__story { min-height: clamp(460px, 62svh, 560px); }
    .mayaloka-hero__story .mayaloka-hero__frame { padding: 52px 24px 28px; }
    .mayaloka-hero__story .mayaloka-hero__heading { font-size: clamp(32px, 5vw, 48px); }
    .mayaloka-hero__story .mayaloka-hero__subtext { font-size: 15px; line-height: 1.5; }
    .mayaloka-hero__collections { padding: 24px; border-left: 0; }
    .mayaloka-hero__mobile-ticker { display: block; background: var(--mayaloka-maroon); color: var(--mayaloka-gold-soft); overflow: hidden; white-space: nowrap; padding: 10px 0; border-block: 2px solid var(--mayaloka-gold); }
    .mayaloka-hero__mobile-ticker-track { display: inline-flex; align-items: center; gap: 24px; animation: mayaloka-scroll-left 26s linear infinite; }
    .mayaloka-hero__mobile-ticker-track span { font-family: var(--mayaloka-font-label); font-size: 10px; letter-spacing: .11em; text-transform: uppercase; }
  }
  @media (prefers-reduced-motion: reduce) { .mayaloka-hero__mobile-ticker-track { animation: none; } }

  @media (max-width: 989px) {
    .mayaloka-hero--compact .mayaloka-hero__frame {
      padding: 52px 24px 28px;
    }
  }

  @media (max-width: 749px) {
    .mayaloka-hero--split.mayaloka-hero--image { display: block; min-height: 0; }
    .mayaloka-hero--compact.mayaloka-hero--image {
      min-height: 0;
    }

    .mayaloka-hero--compact .mayaloka-hero__frame {
      padding: 34px 18px 22px;
    }
    .mayaloka-hero__story .mayaloka-hero__ctas { display: flex; flex-wrap: nowrap; gap: 8px; margin-bottom: 12px; }
    .mayaloka-hero__story .mayaloka-btn { flex: 1 1 0; min-width: 0; padding: 11px 7px; font-size: 9px; letter-spacing: .035em; white-space: nowrap; }
    .mayaloka-hero__story .mayaloka-flourish { display: none; }
    .mayaloka-hero__story .mayaloka-hero__badge { display: block; white-space: nowrap; font-size: 8px; letter-spacing: .075em; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Mayaloka Hero",
  "tag": "section",
  "class": "mayaloka-section",
  "settings": [
    {
      "type": "select",
      "id": "size",
      "label": "Hero height",
      "options": [
        { "value": "compact", "label": "Compact" },
        { "value": "large", "label": "Large" }
      ],
      "default": "large"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero image",
      "info": "This image fills the hero background behind the text."
    },
    {
      "type": "image_picker",
      "id": "hero_image_mobile",
      "label": "Mobile hero image (optional)",
      "info": "Shown on screens 749px wide or smaller. Leave empty to use the desktop hero image."
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Modern treasures · Old Indian magic"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading (roman part)",
    },
    {
      "type": "text",
      "id": "heading_emphasis",
      "label": "Heading (italic part)",
      "default": "a treasure discovered."
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Where every piece feels like a treasure discovered. Wrapped in nostalgia and modernity."
    },
    {
      "type": "text",
      "id": "primary_button_label",
      "label": "Primary button label",
      "default": "Explore the Collection"
    },
    {
      "type": "url",
      "id": "primary_button_url",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "secondary_button_label",
      "label": "Secondary button label",
      "default": "Our Story"
    },
    {
      "type": "url",
      "id": "secondary_button_url",
      "label": "Secondary button link"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Trust badge text",
      "default": "Fashion Jewellery and more"
    }
  ],
  "max_blocks": 5,
  "blocks": [
    {
      "type": "collection",
      "name": "Collection tile",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Mayaloka Hero"
    }
  ]
}
{% endschema %}
