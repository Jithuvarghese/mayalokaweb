{% liquid
  assign label = section.settings.label
  assign heading = section.settings.heading
  assign section_id = 'mayaloka-testimonials-' | append: section.id

  assign quote_count = 0
  for block in section.blocks
    if block.settings.quote != blank
      assign quote_count = quote_count | plus: 1
    endif
  endfor
%}

{% if quote_count > 0 or request.design_mode %}
  <section class="mayaloka-testimonials" id="{{ section_id }}" aria-roledescription="carousel" aria-label="{{ heading | default: 'Customer reviews' | escape }}">
    <div class="mayaloka-testimonials__wrap">
      <div class="mayaloka-sec-head">
        {% if label != blank %}
          <span class="mayaloka-label{% if label == 'Kind Words' %} mayaloka-label--prominent{% endif %}">{{ label }}</span>
        {% endif %}
        {% if heading != blank %}
          <h2>{{ heading }}</h2>
        {% endif %}
      </div>

      {% if quote_count == 0 %}
        <p class="mayaloka-testimonials__empty">Add a testimonial block with a real customer quote. This section stays hidden on the store until one exists.</p>
      {% else %}
        <div class="mayaloka-testimonials__carousel">
          <button type="button" class="mayaloka-testimonials__nav" aria-label="Previous review" data-testimonials-prev>&#8249;</button>

          <ul class="mayaloka-testimonials__track" data-testimonials-track role="list">
            {% for block in section.blocks %}
              {% if block.settings.quote != blank %}
                {% assign rating = block.settings.rating %}
                <li class="mayaloka-testimonials__card" {{ block.shopify_attributes }}>
                  <figure>
                    {% if rating > 0 %}
                      <div class="mayaloka-testimonials__stars" role="img" aria-label="{{ rating }} out of 5 stars">
                        {%- for i in (1..5) -%}
                          <span class="{% if i <= rating %}is-on{% endif %}" aria-hidden="true">★</span>
                        {%- endfor -%}
                      </div>
                    {% endif %}
                    <blockquote class="mayaloka-testimonials__quote">“{{ block.settings.quote }}”</blockquote>
                    <figcaption class="mayaloka-testimonials__author">
                      {% if block.settings.name != blank %}
                        <span class="mayaloka-testimonials__name">{{ block.settings.name }}</span>
                      {% endif %}
                      {% if block.settings.location != blank %}
                        <span class="mayaloka-testimonials__location">{{ block.settings.location }}</span>
                      {% endif %}
                      {% if block.settings.product != blank %}
                        <a class="mayaloka-testimonials__product" href="{{ block.settings.product.url }}">
                          on {{ block.settings.product.title }}
                        </a>
                      {% endif %}
                    </figcaption>
                  </figure>
                </li>
              {% endif %}
            {% endfor %}
          </ul>

          <button type="button" class="mayaloka-testimonials__nav" aria-label="Next review" data-testimonials-next>&#8250;</button>
        </div>
      {% endif %}
    </div>
  </section>

  <script>
    (function () {
      var root = document.getElementById({{ section_id | json }});
      if (!root) return;
      var track = root.querySelector('[data-testimonials-track]');
      if (!track) return;
      var prev = root.querySelector('[data-testimonials-prev]');
      var next = root.querySelector('[data-testimonials-next]');
      var originals = Array.prototype.slice.call(track.children);
      if (!originals.length) return;

      var interval = {{ section.settings.autoplay_speed | times: 1000 | json }};
      var autoplay = {{ section.settings.autoplay | json }};
      var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var behavior = reduceMotion ? 'auto' : 'smooth';

      // Only loop when the reviews don't all fit on screen at once.
      var overflows = track.scrollWidth > track.clientWidth + 2;

      // Endless loop: append one copy of the reviews (hidden from screen readers
      // and keyboard). When we scroll into the copy we jump back by one set's
      // width; because the copy looks identical, the jump can't be seen.
      if (overflows) {
        originals.forEach(function (card) {
          var clone = card.cloneNode(true);
          clone.setAttribute('aria-hidden', 'true');
          clone.setAttribute('inert', '');
          clone.removeAttribute('data-shopify-editor-block');
          track.appendChild(clone);
        });
      }

      function gap() {
        return parseFloat(getComputedStyle(track).columnGap) || 0;
      }

      function setWidth() {
        return track.children[originals.length].offsetLeft - originals[0].offsetLeft;
      }

      function stepSize() {
        return originals[0].getBoundingClientRect().width + gap();
      }

      function jump(left) {
        track.style.scrollSnapType = 'none';
        track.scrollLeft = left;
        track.offsetWidth; // apply before re-enabling snap
        track.style.scrollSnapType = '';
      }

      function go(dir) {
        if (!overflows) {
          track.scrollBy({ left: dir * stepSize(), behavior: behavior });
          return;
        }
        var w = setWidth();
        if (dir > 0 && track.scrollLeft >= w - 2) jump(track.scrollLeft - w);
        if (dir < 0 && track.scrollLeft <= 2) jump(track.scrollLeft + w);
        track.scrollBy({ left: dir * stepSize(), behavior: behavior });
      }

      // Autoplay. Pauses while a finger is on it, while keyboard focus is
      // inside, when it's scrolled off screen, and when the tab is hidden.
      var timer = null;
      var touching = false;
      var focused = false;
      var visible = true;

      function tick() {
        if (touching || focused || !visible || document.hidden) return;
        go(1);
      }

      function start() {
        if (!autoplay || reduceMotion || !overflows) return;
        if (timer) clearInterval(timer);
        timer = setInterval(tick, interval);
      }

      root.addEventListener('focusin', function (e) {
        if (e.target.matches && e.target.matches(':focus-visible')) focused = true;
      });
      root.addEventListener('focusout', function () { focused = false; });
      track.addEventListener('touchstart', function () { touching = true; }, { passive: true });
      track.addEventListener('touchend', function () { touching = false; start(); }, { passive: true });

      if ('IntersectionObserver' in window) {
        new IntersectionObserver(function (entries) {
          visible = entries[0].isIntersecting;
        }, { threshold: 0.3 }).observe(track);
      }

      if (prev) prev.addEventListener('click', function () { go(-1); start(); });
      if (next) next.addEventListener('click', function () { go(1); start(); });

      if (!overflows) {
        if (prev) prev.hidden = true;
        if (next) next.hidden = true;
      }

      start();
    })();
  </script>
{% endif %}

{% stylesheet %}
  .mayaloka-testimonials {
    padding: 48px 0;
    background: var(--mayaloka-paper);
  }

  /* Tighter header than other sections so the reviews stay compact. */
  .mayaloka-testimonials .mayaloka-sec-head {
    margin-bottom: 28px;
  }

  .mayaloka-testimonials .mayaloka-sec-head .mayaloka-label {
    margin-bottom: 8px;
  }

  .mayaloka-testimonials .mayaloka-sec-head h2 {
    font-size: clamp(26px, 3vw, 34px);
    margin-bottom: 0;
  }

  .mayaloka-testimonials__wrap {
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 32px;
  }

  .mayaloka-testimonials__empty {
    text-align: center;
    color: var(--mayaloka-ink-soft);
    font-size: 14px;
  }

  .mayaloka-testimonials__carousel {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .mayaloka-testimonials__track {
    display: flex;
    gap: 20px;
    flex: 1;
    min-width: 0;
    margin: 0;
    padding: 4px;
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .mayaloka-testimonials__track::-webkit-scrollbar {
    display: none;
  }

  .mayaloka-testimonials__card {
    flex: 0 0 calc((100% - 40px) / 3);
    scroll-snap-align: start;
    background: var(--mayaloka-cream-light);
    border: 1px solid rgba(36, 30, 25, .12);
    padding: 22px 24px;
  }

  .mayaloka-testimonials__card figure {
    margin: 0;
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .mayaloka-testimonials__stars {
    font-size: 15px;
    letter-spacing: 3px;
    color: rgba(36, 30, 25, .18);
    margin-bottom: 10px;
  }

  .mayaloka-testimonials__stars .is-on {
    color: var(--mayaloka-gold);
  }

  .mayaloka-testimonials__quote {
    margin: 0 0 14px;
    font-family: var(--mayaloka-font-display);
    font-size: 17px;
    line-height: 1.5;
    color: var(--mayaloka-ink);
    flex: 1;
  }

  .mayaloka-testimonials__author {
    display: flex;
    flex-direction: column;
    gap: 3px;
    font-family: var(--mayaloka-font-body);
    font-size: 13px;
  }

  .mayaloka-testimonials__name {
    font-weight: 600;
    color: var(--mayaloka-maroon);
  }

  .mayaloka-testimonials__location {
    color: var(--mayaloka-ink-soft);
  }

  .mayaloka-testimonials__product {
    color: var(--mayaloka-ink-soft);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .mayaloka-testimonials__nav {
    flex: 0 0 auto;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid var(--mayaloka-maroon);
    background: var(--mayaloka-cream-light);
    color: var(--mayaloka-maroon);
    font-size: 22px;
    line-height: 1;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background .2s, color .2s, opacity .2s;
  }

  .mayaloka-testimonials__nav:hover:not(:disabled) {
    background: var(--mayaloka-maroon);
    color: var(--mayaloka-cream-light);
  }

  .mayaloka-testimonials__nav[hidden] {
    display: none;
  }

  .mayaloka-testimonials__nav:disabled {
    opacity: .35;
    cursor: default;
  }

  @media screen and (max-width: 989px) {
    .mayaloka-testimonials__card {
      flex-basis: calc((100% - 20px) / 2);
    }
  }

  @media screen and (max-width: 749px) {
    .mayaloka-testimonials {
      padding: 36px 0;
    }

    .mayaloka-testimonials__wrap {
      padding: 0 16px;
    }

    .mayaloka-testimonials__nav {
      display: none;
    }

    .mayaloka-testimonials__card {
      flex-basis: 85%;
      padding: 18px 18px;
    }

    .mayaloka-testimonials__quote {
      font-size: 16px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Mayaloka Testimonials",
  "tag": "div",
  "class": "mayaloka-section",
  "max_blocks": 12,
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "Kind Words"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Loved by our customers"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Auto-rotate reviews",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Seconds between slides",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 5
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "info": "Use real customer words only."
        },
        {
          "type": "text",
          "id": "name",
          "label": "Customer name"
        },
        {
          "type": "text",
          "id": "location",
          "label": "City (optional)"
        },
        {
          "type": "range",
          "id": "rating",
          "label": "Star rating (0 hides stars)",
          "min": 0,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "product",
          "id": "product",
          "label": "Product reviewed (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Mayaloka Testimonials"
    }
  ]
}
{% endschema %}
