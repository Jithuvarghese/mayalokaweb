{% liquid
  assign eyebrow = section.settings.eyebrow
  assign heading = section.settings.heading
  assign subtext = section.settings.subtext
  assign collection = section.settings.collection
  assign products_to_show = section.settings.products_to_show
  assign section_id = 'mayaloka-mombatti-' | append: section.id
%}

<section class="mayaloka-mombatti">
  <div class="mayaloka-mombatti__wrap">
    <div class="mayaloka-sec-head">
      {% if eyebrow != blank %}
        <span class="mayaloka-label">{{ eyebrow }}</span>
      {% endif %}
      {% if heading != blank %}
        <h2>{{ heading }}</h2>
      {% endif %}
      {% if subtext != blank %}
        <p>{{ subtext }}</p>
      {% endif %}
    </div>

    {% if collection != blank and collection.products.size > 0 %}
      <div class="mayaloka-mombatti__carousel" id="{{ section_id }}">
        <button
          type="button"
          class="mayaloka-mombatti__nav mayaloka-mombatti__nav--prev"
          aria-label="Previous"
          data-mombatti-prev
        >&#8249;</button>

        <div class="mayaloka-mombatti__track" data-mombatti-track>
          {% for product in collection.products limit: products_to_show %}
            <a href="{{ product.url }}" class="mayaloka-mombatti__card">
              <div class="mayaloka-mombatti__img">
                {% if product.featured_image != blank %}
                  {{ product.featured_image | image_url: width: 500 | image_tag: loading: 'lazy', class: 'mayaloka-mombatti__photo' }}
                {% endif %}
                {% if product.available == false %}
                  <span class="mayaloka-mombatti__tag">Sold out</span>
                {% endif %}
              </div>
              <div class="mayaloka-mombatti__info">
                <span class="mayaloka-mombatti__brand">Mombatti</span>
                <h3>{{ product.title }}</h3>
                <div class="mayaloka-mombatti__price">
                  {% if product.compare_at_price > product.price %}
                    <s>{{ product.compare_at_price | money }}</s>{{ product.price | money }}
                  {% else %}
                    {{ product.price | money }}
                  {% endif %}
                </div>
              </div>
            </a>
          {% endfor %}
        </div>

        <button
          type="button"
          class="mayaloka-mombatti__nav mayaloka-mombatti__nav--next"
          aria-label="Next"
          data-mombatti-next
        >&#8250;</button>
      </div>
    {% endif %}
  </div>
</section>

<script>
  (function () {
    var root = document.getElementById({{ section_id | json }});
    if (!root) return;
    var track = root.querySelector('[data-mombatti-track]');
    var prev = root.querySelector('[data-mombatti-prev]');
    var next = root.querySelector('[data-mombatti-next]');

    function scrollByCard(dir) {
      var card = track.querySelector('.mayaloka-mombatti__card');
      if (!card) return;
      var amount = card.getBoundingClientRect().width + 20;
      track.scrollBy({ left: dir * amount, behavior: 'smooth' });
    }

    if (prev) prev.addEventListener('click', function () { scrollByCard(-1); });
    if (next) next.addEventListener('click', function () { scrollByCard(1); });
  })();
</script>

{% stylesheet %}
  .mayaloka-mombatti {
    padding: 90px 0;
    background: var(--mayaloka-cream-light);
  }

  .mayaloka-mombatti__wrap {
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 32px;
  }

  .mayaloka-mombatti__carousel {
    position: relative;
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .mayaloka-mombatti__track {
    display: flex;
    gap: 22px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    padding: 4px;
    flex: 1;
  }

  .mayaloka-mombatti__track::-webkit-scrollbar {
    display: none;
  }

  .mayaloka-mombatti__card {
    flex: 0 0 auto;
    width: 260px;
    scroll-snap-align: start;
    text-decoration: none;
    color: inherit;
    display: block;
  }

  .mayaloka-mombatti__img {
    aspect-ratio: 4 / 5;
    position: relative;
    overflow: hidden;
    background: var(--mayaloka-paper);
    margin-bottom: 14px;
  }

  .mayaloka-mombatti__photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform .5s ease;
  }

  .mayaloka-mombatti__card:hover .mayaloka-mombatti__photo {
    transform: scale(1.06);
  }

  .mayaloka-mombatti__tag {
    position: absolute;
    top: 10px;
    left: 10px;
    background: var(--mayaloka-cream-light);
    color: var(--mayaloka-maroon);
    font-size: 10px;
    letter-spacing: .08em;
    padding: 4px 8px;
    font-family: var(--mayaloka-font-label);
    text-transform: uppercase;
  }

  .mayaloka-mombatti__brand {
    display: block;
    font-family: var(--mayaloka-font-label);
    font-size: 11px;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--mayaloka-maroon);
    margin-bottom: 6px;
  }

  .mayaloka-mombatti__info h3 {
    font-family: var(--mayaloka-font-body);
    font-size: 15px;
    font-weight: 600;
    margin: 0 0 6px;
    color: var(--mayaloka-ink);
  }

  .mayaloka-mombatti__price {
    font-family: var(--mayaloka-font-body);
    font-size: 14px;
    color: var(--mayaloka-maroon);
    font-weight: 600;
  }

  .mayaloka-mombatti__price s {
    color: var(--mayaloka-ink-soft);
    font-weight: 400;
    margin-right: 6px;
  }

  .mayaloka-mombatti__nav {
    flex: 0 0 auto;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid var(--mayaloka-maroon);
    background: var(--mayaloka-cream-light);
    color: var(--mayaloka-maroon);
    font-size: 22px;
    line-height: 1;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background .2s, color .2s;
  }

  .mayaloka-mombatti__nav:hover {
    background: var(--mayaloka-maroon);
    color: var(--mayaloka-cream-light);
  }

  @media screen and (max-width: 600px) {
    .mayaloka-mombatti__card {
      width: 190px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Mombatti Arrivals",
  "tag": "section",
  "class": "mayaloka-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label",
      "default": "New In"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Mombatti New Arrivals"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Hand-poured scented candles, fresh from the Mombatti workshop."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Select the Mombatti collection to pull products from."
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 4,
      "max": 16,
      "step": 1,
      "default": 8
    }
  ],
  "presets": [
    {
      "name": "Mombatti Arrivals"
    }
  ]
}
{% endschema %}
