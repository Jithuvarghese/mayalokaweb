{%- comment -%}
  Preview-only product page for one Mombatti candle (see snippets/mombatti-demo-candle.liquid).
  Rendered by templates/index.mombatti-<key>.json, reached via /?view=mombatti-<key>.
{%- endcomment -%}

<section class="mayaloka-mombatti-demo" id="mombatti-demo-{{ section.id }}">
  {% render 'mombatti-demo-candle',
    key: section.settings.candle,
    mode: 'detail',
    all_keys: section.settings.more_candles
  %}
</section>

<script>
  (function () {
    var root = document.getElementById({{ 'mombatti-demo-' | append: section.id | json }});
    if (!root) return;
    var main = root.querySelector('[data-mombatti-main]');
    root.querySelectorAll('.mombatti-pdp__thumb').forEach(function (thumb) {
      thumb.addEventListener('click', function () {
        main.src = thumb.dataset.src;
        root.querySelectorAll('.mombatti-pdp__thumb').forEach(function (t) {
          t.classList.toggle('is-active', t === thumb);
        });
      });
    });
  })();
</script>

{% stylesheet %}
  .mombatti-pdp {
    max-width: 1240px;
    margin: 0 auto;
    padding: 40px 32px 90px;
  }

  .mombatti-pdp__crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    font-family: var(--mayaloka-font-label);
    font-size: 11px;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--mayaloka-ink-soft);
    margin-bottom: 28px;
  }

  .mombatti-pdp__crumbs a {
    color: inherit;
    text-decoration: none;
  }

  .mombatti-pdp__crumbs a:hover {
    color: var(--mayaloka-maroon);
  }

  .mombatti-pdp__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: 56px;
    align-items: start;
  }

  .mombatti-pdp__main {
    aspect-ratio: 4 / 5;
    background: var(--mayaloka-paper);
    overflow: hidden;
  }

  .mombatti-pdp__main img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .mombatti-pdp__thumbs {
    display: flex;
    gap: 10px;
    margin-top: 12px;
    flex-wrap: wrap;
  }

  .mombatti-pdp__thumb {
    width: 76px;
    height: 76px;
    padding: 0;
    border: 1px solid transparent;
    background: var(--mayaloka-paper);
    cursor: pointer;
    overflow: hidden;
    opacity: .7;
    transition: opacity .2s, border-color .2s;
  }

  .mombatti-pdp__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .mombatti-pdp__thumb:hover,
  .mombatti-pdp__thumb.is-active {
    opacity: 1;
    border-color: var(--mayaloka-maroon);
  }

  .mombatti-pdp__info {
    position: sticky;
    top: 120px;
  }

  .mombatti-pdp__title {
    font-family: var(--mayaloka-font-display);
    font-size: clamp(28px, 3.2vw, 40px);
    line-height: 1.15;
    color: var(--mayaloka-ink);
    margin: 10px 0 14px;
  }

  .mombatti-pdp__price {
    font-family: var(--mayaloka-font-body);
    font-size: 20px;
    font-weight: 600;
    color: var(--mayaloka-maroon);
    margin: 0 0 22px;
  }

  .mombatti-pdp__desc {
    font-family: var(--mayaloka-font-body);
    font-size: 15px;
    line-height: 1.75;
    color: var(--mayaloka-ink-soft);
    margin: 0 0 28px;
  }

  .mombatti-pdp__cta {
    width: 100%;
    padding: 16px 24px;
    border: 0;
    background: var(--mayaloka-maroon);
    color: var(--mayaloka-cream-light);
    font-family: var(--mayaloka-font-label);
    font-size: 13px;
    letter-spacing: .12em;
    text-transform: uppercase;
    cursor: not-allowed;
    opacity: .85;
  }

  .mombatti-pdp__note {
    font-family: var(--mayaloka-font-body);
    font-size: 12px;
    color: var(--mayaloka-ink-soft);
    margin: 8px 0 32px;
    text-align: center;
  }

  .mombatti-pdp__details {
    border-top: 1px solid var(--mayaloka-pdp-border, rgba(0, 0, 0, .1));
    padding-top: 22px;
  }

  .mombatti-pdp__details h2 {
    font-family: var(--mayaloka-font-label);
    font-size: 12px;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--mayaloka-ink);
    margin: 0 0 14px;
  }

  .mombatti-pdp__details ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .mombatti-pdp__details li {
    display: grid;
    grid-template-columns: 110px 1fr;
    gap: 12px;
    padding: 9px 0;
    border-bottom: 1px solid var(--mayaloka-pdp-border, rgba(0, 0, 0, .06));
    font-family: var(--mayaloka-font-body);
    font-size: 14px;
    color: var(--mayaloka-ink);
  }

  .mombatti-pdp__details li span {
    color: var(--mayaloka-ink-soft);
  }

  .mombatti-pdp__more {
    margin-top: 90px;
  }

  .mombatti-pdp__more-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 22px;
  }

  .mombatti-pdp__more-grid .mayaloka-mombatti__card {
    width: auto;
  }

  @media screen and (max-width: 900px) {
    .mombatti-pdp__grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .mombatti-pdp__info {
      position: static;
    }

    .mombatti-pdp__more-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 600px) {
    .mombatti-pdp {
      padding: 24px 18px 60px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Mombatti candle (preview)",
  "tag": "div",
  "class": "mayaloka-section",
  "settings": [
    {
      "type": "select",
      "id": "candle",
      "label": "Candle",
      "options": [
        { "value": "lotus-pond", "label": "Lotus Pond" },
        { "value": "strawberry-jam", "label": "Strawberry Jam" },
        { "value": "chai-parle-g", "label": "Chai and Parle-G" },
        { "value": "love-letter", "label": "Fortune: Love Letter" },
        { "value": "note-from-god", "label": "Fortune: Note from God" },
        { "value": "happy-birthday", "label": "Fortune: Happy Birthday" },
        { "value": "jack-daniel-whiskey", "label": "Jack Daniel Whiskey" },
        { "value": "iced-matcha", "label": "Iced Matcha" }
      ],
      "default": "lotus-pond"
    },
    {
      "type": "text",
      "id": "more_candles",
      "label": "More candles (comma-separated keys)",
      "default": "lotus-pond,strawberry-jam,chai-parle-g,love-letter,note-from-god,happy-birthday,jack-daniel-whiskey,iced-matcha"
    }
  ]
}
{% endschema %}
