{%- doc -%}
  Design tokens for the custom Mayaloka homepage sections (mayaloka-*.liquid).
  Colors and typography per Mayaloka_Colour_Palette_Typography.pdf (client spec):
  Terracotta / Powder Sky / Antique Gold / Black / White,
  Playfair Display (headings) / Cormorant Garamond (subheadings) / Lato (body).
{%- enddoc -%}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link
  href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..900;1,400..900&family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Lato:ital,wght@0,400;0,700;1,400&display=swap"
  rel="stylesheet"
>
<style>
  :root {
    /* Client palette (Mayaloka_Colour_Palette_Typography.pdf) mapped onto our existing role names */
    --mayaloka-maroon: #812B23;       /* Terracotta */
    --mayaloka-maroon-dark: #611F19;  /* darker shade of Terracotta for hover states */
    --mayaloka-cream: #FFFFFF;        /* White */
    --mayaloka-cream-light: #FFFFFF;  /* White */
    --mayaloka-paper: #F5F5F5;        /* near-white for alternating section backgrounds */
    --mayaloka-gold: #D3AD4F;         /* Antique Gold */
    --mayaloka-gold-soft: #E0C27D;    /* lighter shade of Antique Gold */
    --mayaloka-ink: #000000;          /* Black */
    --mayaloka-ink-soft: #4A4A4A;     /* soft black/grey for secondary text */
    --mayaloka-font-display: 'Playfair Display', serif;
    --mayaloka-font-label: 'Cormorant Garamond', serif;
    --mayaloka-font-body: 'Lato', sans-serif;
  }

  .mayaloka-section * {
    box-sizing: border-box;
  }

  .mayaloka-flourish {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
  }

  .mayaloka-flourish__dash {
    width: 34px;
    height: 1px;
    background: var(--mayaloka-maroon);
    opacity: .55;
  }

  .mayaloka-flourish__dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--mayaloka-maroon);
    opacity: .8;
  }

  .mayaloka-btn {
    display: inline-block;
    padding: 14px 30px;
    font-family: var(--mayaloka-font-body);
    font-size: 13px;
    letter-spacing: .08em;
    text-transform: uppercase;
    font-weight: 600;
    border-radius: 2px;
    cursor: pointer;
    transition: all .25s ease;
    border: 1px solid transparent;
    text-decoration: none;
  }

  .mayaloka-btn--primary {
    background: var(--mayaloka-gold);
    color: var(--mayaloka-ink);
  }

  .mayaloka-btn--primary:hover {
    background: var(--mayaloka-gold-soft);
    transform: translateY(-2px);
  }

  .mayaloka-btn--outline {
    border-color: var(--mayaloka-maroon);
    color: var(--mayaloka-maroon);
    background: transparent;
  }

  .mayaloka-btn--outline:hover {
    background: var(--mayaloka-maroon);
    color: var(--mayaloka-cream-light);
    transform: translateY(-2px);
  }

  .mayaloka-label {
    font-family: var(--mayaloka-font-label);
    text-transform: uppercase;
    letter-spacing: .16em;
    font-size: 12px;
    color: var(--mayaloka-maroon);
  }

  .mayaloka-sec-head {
    text-align: center;
    max-width: 640px;
    margin: 0 auto 52px;
  }

  .mayaloka-sec-head .mayaloka-label {
    display: block;
    margin-bottom: 14px;
  }

  .mayaloka-sec-head h2 {
    font-family: var(--mayaloka-font-display);
    font-weight: 600;
    font-size: clamp(30px, 4vw, 44px);
    margin: 0 0 16px;
    color: var(--mayaloka-ink);
  }

  .mayaloka-sec-head p {
    color: var(--mayaloka-ink-soft);
    font-size: 15.5px;
    margin: 0;
  }

  .mayaloka-reveal {
    opacity: 0;
    transform: translateY(22px);
    transition: opacity .8s ease, transform .8s ease;
  }

  .mayaloka-reveal.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .mayaloka-reveal {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }

  /* ---------- subheading font override: Cormorant Garamond per client spec ----------
     Shopify's font_picker doesn't expose a valid weight-500/600 handle for Cormorant
     Garamond, so it's loaded directly via the Google Fonts link above and applied here
     instead of through settings_data.json's type_subheading_font/type_accent_font. */
  :root {
    --font-subheading--family: 'Cormorant Garamond', serif !important;
    --font-accent--family: 'Cormorant Garamond', serif !important;
  }

  /* ---------- footer: gold panel with editorial spacing matching the Mayaloka reference ---------- */
  footer {
    background: var(--mayaloka-gold);
    color: rgba(36, 30, 25, 0.88);
  }

  footer .section {
    background: var(--mayaloka-gold);
    color: rgba(36, 30, 25, 0.88);
  }

  footer .section-background {
    display: none;
  }

  footer .footer-content {
    display: grid;
    grid-template-columns: minmax(220px, 1.25fr) minmax(260px, 1.4fr) minmax(300px, 1.8fr);
    gap: 0 3.5rem;
    align-items: start;
    justify-items: start;
    padding-block: 2.5rem 2rem;
  }

  footer .footer-content > * {
    min-width: 0;
  }

  footer .footer-content > :nth-child(2) {
    width: 100%;
    justify-self: center;
  }

  footer .footer-content > :nth-child(2) .group-block-content {
    justify-content: center;
    gap: 2.5rem;
  }

  footer .footer-content > :nth-child(3) {
    width: 100%;
    justify-self: end;
    display: flex;
    justify-content: flex-end;
  }

  footer .footer-content > :nth-child(3) > .group-block {
    width: 100%;
    max-width: 30rem;
    margin-left: auto;
  }

  footer .logo-block {
    width: auto;
    max-width: max-content;
    margin-bottom: 1.1rem;
  }

  footer .logo-block__image-wrapper {
    display: flex;
    align-items: center;
  }

  footer .logo-block__image {
    width: auto;
    max-width: 200px;
    height: auto;
    object-fit: contain;
    filter: none;
    opacity: 1;
  }

  footer .group-block-content p,
  footer .group-block-content h3,
  footer .group-block-content .rte,
  footer .group-block-content .paragraph,
  footer .menu__heading__default,
  footer .menu__item a,
  footer .email-signup__button,
  footer .email-signup__input,
  footer .email-signup__input::placeholder {
    color: rgba(36, 30, 25, 0.88);
  }

  footer .menu {
    width: auto;
    margin: 0;
  }

  footer .menu__heading__default {
    display: block;
    margin-bottom: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 0.72rem;
    font-weight: 600;
    line-height: 1.3;
    font-family: var(--mayaloka-font-body);
  }

  footer .menu__item {
    margin: 0;
  }

  footer .menu__item + .menu__item {
    margin-top: 0.55rem;
  }

  footer .menu__item a {
    font-size: 1.05rem;
    font-weight: 400;
    line-height: 1.4;
    text-decoration: none;
    transition: opacity 0.2s ease;
    font-family: var(--mayaloka-font-body);
  }

  footer .menu__item a:hover {
    opacity: 0.75;
  }

  footer .group-block-content p {
    margin: 0;
    font-size: 1rem;
    line-height: 1.5;
    max-width: 28rem;
    font-family: var(--mayaloka-font-body);
  }

  footer .footer-content > :first-child .group-block-content p {
    color: #241E19;
    font-weight: 700;
  }

  footer .group-block-content h3 {
    margin: 0 0 0.5rem;
    font-size: 1.7rem;
    line-height: 1.1;
    letter-spacing: 0.02em;
    font-family: var(--mayaloka-font-display);
    font-weight: 500;
  }

  footer .group-block-content h3 em {
    font-style: italic;
  }

  footer .email-signup-block {
    width: 100%;
    max-width: 100%;
  }

  footer .email-signup__form {
    width: 100%;
  }

  footer .email-signup__input-group {
    width: 100%;
    border: 1px solid rgba(36, 30, 25, 0.38);
    background: rgba(255, 255, 255, 0.12);
    border-radius: 0;
    overflow: hidden;
  }

  footer .email-signup__input {
    min-height: 3.1rem;
    background: rgba(255, 255, 255, 0.08);
    border: none;
    border-radius: 0;
    padding: 0.9rem 1rem;
    font-size: 0.95rem;
    line-height: 1.2;
    font-family: var(--mayaloka-font-body);
  }

  footer .email-signup__input::placeholder {
    opacity: 1;
    font-style: normal;
    font-family: var(--mayaloka-font-body);
  }

  footer .email-signup__button {
    min-height: 3.1rem;
    padding: 0.9rem 1.5rem;
    border: 1px solid rgba(36, 30, 25, 0.38);
    background: rgba(255, 255, 255, 0.9);
    border-radius: 0;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1.2;
    font-family: var(--mayaloka-font-body);
  }

  footer .email-signup__button:hover {
    background: rgba(255, 255, 255, 1);
  }

  footer .footer-utilities {
    border-top: 1px solid rgba(36, 30, 25, 0.26);
    margin-top: 1.75rem;
    padding-top: 1.25rem;
  }

  @media screen and (min-width: 990px) {
    footer .footer-content > :nth-child(2) {
      margin-left: 0;
    }

    footer .footer-content > :nth-child(4) {
      margin-left: auto;
    }
  }

  /* Each footer menu (.menu { width: 100% } in blocks/menu.liquid) stretches to fill
     an equal flex share of the row, forcing "Customer Care" to wrap even though there's
     room overall. Let each menu size to its own content instead of stretching. */
  footer .footer-content > :nth-child(2) .menu {
    width: auto;
    flex: 0 0 auto;
  }

  @media screen and (max-width: 989px) {
    footer .footer-content {
      grid-template-columns: 1fr 1fr;
      gap: 1.5rem 2rem;
    }
  }

  @media screen and (max-width: 749px) {
    footer .footer-content {
      grid-template-columns: 1fr;
      gap: 1.25rem;
      padding-block: 2rem 1.25rem;
    }

    footer .footer-content > :nth-child(2) {
      margin-left: 0;
    }
  }

  /* ---------- header brand: real logo image now set via settings.logo (ML_Primary_CLR.jpg) ---------- */
  .header-logo {
    margin-left: -16px;
  }

  .menu-list__link {
    font-family: var(--mayaloka-font-label) !important;
    letter-spacing: 0.08em !important;
    font-size: 16px !important;
    line-height: 1 !important;
  }

  .menu-list__list {
    gap: 32px !important;
  }

  /* ---------- mobile drawer polish (professional, Milk/Tanishq-style minimal) ---------- */
  .menu-drawer {
    border-right: 1px solid var(--mayaloka-ink-soft, rgba(36, 30, 25, .12));
    max-width: 100vw;
    overflow-x: hidden;
  }

  .menu-drawer img,
  .menu-drawer .resource-card__image,
  .menu-drawer__link-image {
    max-width: 100%;
    object-fit: cover;
  }

  .menu-drawer__menu-item--mainlist {
    font-family: var(--mayaloka-font-body) !important;
    font-size: 15px !important;
    letter-spacing: 0.04em !important;
    text-transform: uppercase;
    font-weight: 500 !important;
  }

  .menu-drawer__menu-item--child,
  .menu-drawer__menu-item--parent {
    font-family: var(--mayaloka-font-body) !important;
    letter-spacing: 0.02em;
  }

  .menu-drawer__close-button,
  .header__icon--summary {
    color: var(--mayaloka-maroon);
  }

  .menu-drawer__list-item--divider {
    border-block-end-color: rgba(36, 30, 25, .1) !important;
  }
</style>
<script src="{{ 'mayaloka-reveal.js' | asset_url }}" defer></script>
